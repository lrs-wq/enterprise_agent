# The web app is exposed to the trusted LAN. Ollama remains on loopback only.
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=8000
AI_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_AGENT_CHAT_MODEL=qwen3.5:9b-mlx
AI_AGENT_EMBEDDING_MODEL=bge-m3
AI_AGENT_MAX_FILE_MB=100
AI_AGENT_MAX_CHAT_REQUEST_KB=64
AI_AGENT_MAX_UPLOAD_REQUEST_MB=100
AI_AGENT_MAX_UPLOAD_FILES=5
AI_AGENT_MAX_PDF_PAGES=300
AI_AGENT_OCR_TIMEOUT_SECONDS=240
AI_AGENT_MAX_SPREADSHEET_ROWS=50000
AI_AGENT_MAX_ARCHIVE_UNCOMPRESSED_MB=256
AI_AGENT_MAX_ARCHIVE_MEMBERS=5000
AI_AGENT_MAX_DOCUMENT_CHUNKS=20000
AI_AGENT_RETRIEVAL_TOP_K=7
AI_AGENT_MIN_RETRIEVAL_SCORE=0.22
AI_AGENT_MODEL_CONTEXT=16384

# Public resource governance. Start conservatively and tune only after load tests.
AI_AGENT_CHAT_MAX_CONCURRENCY=1
AI_AGENT_CHAT_MAX_QUEUE=2
AI_AGENT_CHAT_REQUEST_TIMEOUT_SECONDS=75
AI_AGENT_CHAT_RATE_LIMIT_REQUESTS=12
AI_AGENT_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
AI_AGENT_MODEL_MAX_CONCURRENCY=1
AI_AGENT_MODEL_MAX_QUEUE=4
AI_AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=65
AI_AGENT_EMBEDDING_REQUEST_TIMEOUT_SECONDS=90
AI_AGENT_ADMIN_TASK_MAX_CONCURRENCY=1
AI_AGENT_ADMIN_TASK_MAX_QUEUE=1
AI_AGENT_ADMIN_TASK_TIMEOUT_SECONDS=280
AI_AGENT_ADMIN_AUTH_FAILURE_LIMIT=5
AI_AGENT_ADMIN_AUTH_FAILURE_WINDOW_SECONDS=300

# Required. Generate a unique value, for example: openssl rand -hex 18
# The admin page asks for this token and keeps it only in browser sessionStorage.
AI_AGENT_ADMIN_TOKEN=replace-with-a-random-token

# Optional zero-downtime rotation grace window. Remove both after the UTC expiry.
# AI_AGENT_ADMIN_PREVIOUS_TOKEN=previous-random-token
# AI_AGENT_ADMIN_PREVIOUS_TOKEN_EXPIRES_AT=2026-09-22T00:00:00Z
